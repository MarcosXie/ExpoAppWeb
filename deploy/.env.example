# ExpoApp API .env de produção — copiar para /opt/expo-app/.env na VPS
# NUNCA commitar valores reais. Use este arquivo só como template.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8081
# appsettings.json fixa Kestrel em 5130 — esta var sobrescreve
Kestrel__Endpoints__Http__Url=http://+:8081

# Banco — MySQL local da VPS (rede docker flygates_net)
ConnectionStrings__DB=server=mysql;port=3306;database=expoapp_db;user=expoapp_api;password=CHANGE_ME
ConnectionStrings__DefaultConnection=server=mysql;port=3306;database=expoapp_db;user=expoapp_api;password=CHANGE_ME

# JWT
Jwt__Key=CHANGE_ME
Jwt__Issuer=ExpoAppApi
Jwt__Audience=ExpoApp
Jwt__ExpiresInMinutes=9999999

# AWS (S3 / SES / Translator continuam na AWS)
AWS__Region=us-east-1
AWS__AccessKey=CHANGE_ME
AWS__SecretKey=CHANGE_ME

# SES
SES__SenderEmail=no-reply@uexpo.com.br

# S3 buckets
S3__catalogPdfs=pdfs-catalog
S3__catalogProductsImages=images-products-catalog
S3__userImages=image-usersw2
S3__chatFiles=files-chat
S3__momentoFiles=files-momento

# Azure
AzureSpeech__SubscriptionKey=CHANGE_ME
AzureSpeech__Region=brazilsouth
AzureTranslator__SubscriptionKey=CHANGE_ME
AzureTranslator__Endpoint=https://api.cognitive.microsofttranslator.com/

# Daily.co (video)
DailyCo__BaseUrl=https://api.daily.co/v1/
DailyCo__ApiKey=CHANGE_ME

# Google
GoogleCloudConsole=CHANGE_ME
GoogleCloudConsoleExpoApp=CHANGE_ME

# Firebase Admin (service account decomposto em variáveis)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_PRIVATE_KEY_ID=CHANGE_ME
FIREBASE_PRIVATE_KEY=CHANGE_ME
FIREBASE_CLIENT_EMAIL=CHANGE_ME
FIREBASE_CLIENT_ID=CHANGE_ME
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=CHANGE_ME
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# Front-end
FrontEndUrl=https://expoapp.com.br
IsDev=false
